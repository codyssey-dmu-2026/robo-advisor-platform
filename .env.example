# 복사해서 .env로 사용한다. .env는 커밋하지 않는다. (platform에는 API 키가 필요 없음)
# 로컬 실행 기본값이며, docker-compose에서는 서비스 이름 주소로 덮어쓴다.

# Gateway → 하위 서비스 주소
EVAL_API_URL=http://127.0.0.1:8000
AGENT_API_URL=http://127.0.0.1:8001
RL_API_URL=http://127.0.0.1:8002

# Gateway 하위 호출 타임아웃(초). 요청 1건 5초 SLA 기준
GATEWAY_HEALTH_TIMEOUT_S=2.0
GATEWAY_UPSTREAM_TIMEOUT_S=4.5
GATEWAY_RESEARCH_TIMEOUT_S=4.8

# 대시보드 → Gateway 주소
GATEWAY_URL=http://127.0.0.1:8080

# RL 서빙 서버가 모델을 찾을 rl-engine 레포 경로
RL_REPO_PATH=../rl-engine

# evaluation-xai가 읽을 산출물 폴더 (컨테이너 경로)
EVALUATION_ARTIFACT_DIR=/app/artifacts/demo
