# 복사해서 .env로 사용한다. .env는 커밋하지 않는다. (platform에는 API 키가 필요 없음)
# 로컬 실행 기본값이며, docker-compose에서는 서비스 이름 주소로 덮어쓴다.

# Gateway → 하위 서비스 주소
EVAL_API_URL=http://127.0.0.1:8000
AGENT_API_URL=http://127.0.0.1:8001
RL_API_URL=http://127.0.0.1:8002

# Gateway 하위 호출 타임아웃(초). 요청 1건 5초 SLA 기준
GATEWAY_HEALTH_TIMEOUT_S=2.0
GATEWAY_UPSTREAM_TIMEOUT_S=4.5
GATEWAY_RESEARCH_TIMEOUT_S=4.8

# 대시보드 → Gateway 주소
GATEWAY_URL=http://127.0.0.1:8080

# RL 서빙 서버: 사용할 모델 이름(.zip 제외). 이 값만 바꾸면 모델이 교체됨
RL_MODEL_NAME=ppo_test_w4_simple_s42
# 로컬 실행용 경로 (docker compose에서는 이미지 안의 경로를 사용)
RL_REPO_PATH=../rl-engine
RL_MODELS_DIR=../rl-engine/models
RL_DATA_DIR=../data-pipeline/data/processed

# 리스크 태그 Safe-Guard: 에이전트가 만든 위험 이벤트(RiskTag)로 비중을 줄이는 규칙
# 태그 파일 경로 (로컬 실행용. docker compose에서는 agent-artifacts 볼륨을 사용)
RISK_TAGS_PATH=../agentic-research/artifacts/risk_tags.jsonl
# 위험 점수(심각도 × 신뢰도)가 이 값 이상이면 비중을 줄임
RISK_TAG_THRESHOLD=0.5
# 점수 1.0일 때 줄이는 비율 (0.5 = 비중의 절반)
RISK_TAG_MAX_CUT=0.5

# evaluation-xai가 읽을 산출물 폴더 (컨테이너 경로)
EVALUATION_ARTIFACT_DIR=/app/artifacts/demo

# ---- docker compose bootstrap (모두 선택값, 비워 두면 키 없이 동작) ----
# data-pipeline 뉴스/공시 수집: DART 키가 없으면 DART만 건너뛰고 가격·SEC·한국경제는 수집
DART_API_KEY=
# SEC EDGAR는 User-Agent에 실제 연락처를 요구함 (본인 이메일)
SEC_EDGAR_CONTACT_EMAIL=
# agentic-research: 기본값 rule/hash는 키 없이 동작. openai로 바꾸면 OPENAI_API_KEY 필요
OPENAI_API_KEY=
AGENT_LLM_PROVIDER=rule
AGENT_EMBEDDING_PROVIDER=hash
# 1로 두고 실행하면 데이터 재수집·벡터DB 재생성 (임베딩 제공자를 바꿨을 때 필요)
BOOTSTRAP_FORCE=0
